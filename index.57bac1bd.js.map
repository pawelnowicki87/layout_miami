"use strict";
init();
// ------- F U N C T I O N S -------
function init() {
    sendForm();
    handleMenu();
}
function sendForm() {
    var form = document.getElementById("form");
    form.addEventListener("submit", function(e) {
        e.preventDefault();
        form.reset();
    });
}
function handleMenu() {
    var menu = document.getElementById("menu");
    var htmlBody = document.getElementById("body");
    var showMenuBtn = document.getElementById("show-menu-btn");
    var hideMenuBtn = document.getElementById("hide-menu-btn");
    var menuLinks = document.querySelectorAll(".page-navigation__link");
    showMenuBtn.addEventListener("click", function(e) {
        e.preventDefault();
        if (!menu.classList.contains("menu__open")) {
            htmlBody.classList.add("body--with-menu");
            menu.classList.add("menu__open");
        }
    });
    hideMenuBtn.addEventListener("click", function(e) {
        e.preventDefault();
        if (menu.classList.contains("menu__open")) {
            htmlBody.classList.remove("body--with-menu");
            menu.classList.remove("menu__open");
        }
    });
    menuLinks.forEach(function(el) {
        el.addEventListener("click", function(e) {
            if (menu.classList.contains("menu__open")) {
                htmlBody.classList.remove("body--with-menu");
                menu.classList.remove("menu__open");
            }
        });
    });
}

